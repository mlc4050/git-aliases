[alias]
	shleemypants = "!f() { git rebase -i HEAD~$1; }; f"
	fuckit = reset --hard
	sup = submodule update --init --recursive
	co = checkout
	amend = commit --amend --no-edit
	st = status
	sts = status -s
	br = branch
	nb = checkout -b
	mrg = merge --no-ff --no-commit --edit
	k = !exec gitk --all --date-order &
	g = !exec git gui &
	gl = log --graph --oneline --date-order --decorate=short
	gla = log --graph --oneline --date-order --decorate=short --all
	glw = log --graph --pretty=format:'%C(auto)%h %C(green)%cn %Cblue%cr%Creset%C(auto) %d%s%Creset' --date-order --decorate=short --all
	unstage = reset
	deepfetch = "!find . -type d -name \".git\" -execdir git fetch \\;"
	pending = "!f() {\n  show_worktrees=0\n  case \"$#:$1\" in\n    0:) ;;\n    1:--worktrees) show_worktrees=1 ;;\n    *) printf 'Usage: git pending [--worktrees]\\n' >&2; return 2 ;;\n  esac\n  find . -name .git -prune -print0 | while IFS= read -r -d '' gitdir; do\n    repo=${gitdir%/.git}\n    if [ \"$show_worktrees\" -eq 0 ] && [ -f \"$gitdir\" ]; then\n      metadata=$(git -C \"$repo\" rev-parse --absolute-git-dir 2>/dev/null) || continue\n      [ ! -f \"$metadata/commondir\" ] || continue\n    fi\n    git -C \"$repo\" rev-parse --verify HEAD >/dev/null 2>&1 || continue\n    branch=$(git -C \"$repo\" symbolic-ref --quiet --short HEAD)\n    label=\n    [ -n \"$branch\" ] || label=DETACHED\n    upstream=$(git -C \"$repo\" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)\n    if [ -z \"$upstream\" ]; then\n      [ -z \"$branch\" ] || label=\"NO UPSTREAM: $branch\"\n      upstream=$(git -C \"$repo\" symbolic-ref --quiet --short refs/remotes/origin/HEAD)\n      if ! git -C \"$repo\" rev-parse --verify \"$upstream^{commit}\" >/dev/null 2>&1; then\n        upstream=\n        for ref in origin/main origin/master; do\n          if git -C \"$repo\" rev-parse --verify \"$ref^{commit}\" >/dev/null 2>&1; then\n            if [ -n \"$upstream\" ]; then upstream=; break; fi\n            upstream=$ref\n          fi\n        done\n      fi\n    fi\n    if [ -z \"$upstream\" ]; then\n      printf '%-45s %s; no comparison branch found\n' \"$repo\" \"$label\"\n      continue\n    fi\n    counts=$(git -C \"$repo\" rev-list --left-right --count \"HEAD...$upstream\") || { printf '%s: comparison failed\n' \"$repo\" >&2; continue; }\n    read -r ahead behind <<< \"$counts\"\n    if [ \"$behind\" -gt 0 ] || [ -n \"$label\" ]; then\n      printf '%-45s %s behind' \"$repo\" \"$behind\"\n      if [ \"$ahead\" -gt 0 ]; then\n        printf ' / %s ahead' \"$ahead\"\n        [ \"$behind\" -eq 0 ] || printf ' (DIVERGED)'\n      fi\n      [ -z \"$label\" ] || printf ' [%s; vs %s]' \"$label\" \"$upstream\"\n      printf '\n'\n    fi\n  done\n}; f"
	fadd = "!f() {\n  if [ \"$#\" -ne 1 ] || [ -z \"$1\" ]; then\n    printf '%s\\n' 'Usage: git fadd <filename substring>' >&2\n    return 2\n  fi\n  needle=$1\n  git ls-files --modified --deleted --others --exclude-standard -z |\n    sort -zu |\n    while IFS= read -r -d '' path; do\n      name=${path##*/}\n      case \"$name\" in\n        *\"$needle\"*)\n          git --literal-pathspecs add -- \"$path\" || exit\n          printf 'Staged: %s\\n' \"$path\"\n          ;;\n      esac\n    done\n}; f"
